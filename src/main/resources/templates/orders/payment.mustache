<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="csrf-token" content="{{csrf}}">

        <title inertia>{{appName}}</title>

        <!-- Fonts -->
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap">

        <!-- Styles -->
        <link rel="stylesheet" href="/css/app.css">
        <link rel="stylesheet" href="/css/style.css">
        <link href="/css/font-awesome.css" rel="stylesheet" type="text/css">
        <link href="/fonts/stylesheet.css" rel="stylesheet" type="text/css">
        <link href="/css/owl.carousel.css" rel="stylesheet" type="text/css">
        
        <!-- Scripts -->

    </head>
    <body class="font-sans antialiased">
        <header class="header">
    <div class="container">
        <div class="hdLeft">
            <div class="logo"><a href="/"><img src="/assets/images/logo.png" alt="" /></a></div>
            <div class="navigation">
                <ul>
                    <li><a href="/courses?type=course" class="ak-btn1"><img src="/assets/images/icons-new/course-icon.png" alt="" width="18" height="27"/>Courses</a></li>
                    <li><a href="/courses?type=workshop" class="ak-btn1"><img src="/assets/images/icons-new/workshop-icon.png" alt="" width="26" height="16"/>Workshop</a></li>
                </ul>
            </div>
        </div>
        <div class="hdRit">
            <div class="menuRit">
                <ul>
                    <li class="menu-item-has-children"><a href="/courses">Explore ArtistikCity</a></li>
                </ul>
            </div>
            {{#auth.check}}
                <a class="btn" href="/user/dashboard">Dashboard</a> <a href="javascript:void(0)" class="btn" onclick="$('#logout-form').submit();">Logout</a>
                <form id="logout-form" action="/logout" method="POST" style="display: none;">
                    <input type="hidden" name="_token" value="{{csrf}}">
                </form>
            {{/auth.check}}
            {{#auth.guest}}
                <a class="btn btn2" href="/login">Login</a> <a class="btn" href="/register">Register</a>
            {{/auth.guest}}
        </div>
    </div>
</header>

        


    <div class="breadCrumb">
        <div class="container">
            <ul>
                <li><a href="/">Home</a></li>
                <li>Checkout</li>
            </ul>
        </div>
    </div>

    <div class="checkoutHead">
        <div class="container">
            <h1>Checkout</h1>
        </div>
    </div>

    <div class="container">
        <div class="checkoutwrap">
            <div class="checkoutsteps">
                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-1.png" alt=""> Your ar logged in as:</div>
                        <div class="loginas"><img src="/assets/images/user1.png" alt=""> {{auth.user.name}}</div>
                        <div class="userlogout">
                            <button onclick="$('#logout-form').submit();"><img src="/assets/images/logout-icon.png" alt=""> Logout</button>
                            <form id="logout-form" action="/logout" method="POST" style="display: none;">
                                <input type="hidden" name="_token" value="{{csrf}}">
                            </form>
                        </div>
                    </div>
                </div>

                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-2.png" alt=""> Billing Details</div>
                        <div class="blngAdrs"><p>{{auth.user.name}}, {{auth.user.email}}</p></div>
                        <div class="userlogout"><button id="editBillingInfo"><img src="/assets/images/edit-icon.png" alt=""> Edit</button></div>
                    </div>
                    <div class="stepcontent stepcompleted">
                        <div class="billingform">
                            <form method="post" action="/checkout/billing/{{order.id}}">
                                <input type="hidden" name="_token" value="{{csrf}}">
                                <input type="hidden" name="_method" value="PATCH">
                                <ul>
                                    <li><input type="text" class="field" placeholder="Name" name="billing_name" id="billing_name" value="{{auth.user.name}}"></li>
                                    <li><input type="email" class="field" placeholder="Email" name="billing_email" value="{{auth.user.email}}" readonly></li>
                                    <li class="w100"><input type="text" class="field" placeholder="Address" name="billing_address" id="billing_address" value="{{order.billing_address}}"></li>
                                    <li><input type="text" class="field" placeholder="City" name="billing_city" id="billing_city" value="{{order.billing_city}}"></li>
                                    <li><input type="text" class="field" placeholder="State" name="billing_state" id="billing_state" value="{{order.billing_state}}"></li>
                                    <li>
                                        <select class="field" name="billing_country" id="billing_country">
                                            <option value="">Country</option>
                                            <option value="india" {{#countryIndia}}selected{{/countryIndia}}>India</option>
                                            <option value="usa" {{#countryUsa}}selected{{/countryUsa}}>USA</option>
                                        </select>
                                    </li>
                                    <li><input type="text" class="field" placeholder="Zip Code / Postal Code" name="billing_zipcode" id="billing_zipcode" value="{{order.billing_zipcode}}"></li>
                                    <li class="w100"><input type="submit" class="btn" value="Continue"></li>
                                </ul>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="stepbox">
                    <div class="stephead">
                        <div class="stepname"><img src="/assets/images/step-3.png" alt=""> Payment Option</div>
                    </div>
                    <div class="stepcontent">
                        <div class="paymentoption">
                            <p>Choose your payment option</p>
                            <form action="/checkout/payment" method="POST">
                                <input type="hidden" name="order_id" value="{{order.id}}">
                                <input type="hidden" name="_token" value="{{csrf}}">
                                {{#razorpayKey}}
                                <script src="https://checkout.razorpay.com/v1/checkout.js"
                                        data-key="{{razorpayKey}}"
                                        data-amount="{{course.price_inr_paise}}"
                                        data-buttontext="UPI / Net Banking / Credit Card / Debit Card"
                                        data-name="{{course.title}}"
                                        data-description="Purchase of course: {{course.title}}"
                                        data-image=""
                                        data-prefill.contact="565656567"
                                        data-prefill.name="{{auth.user.name}}"
                                        data-prefill.email="{{auth.user.email}}"
                                        data-theme.color="#ff7529">
                                </script>
                                {{/razorpayKey}}
                                {{^razorpayKey}}
                                {{#paymentTestMode}}
                                <input type="hidden" name="razorpay_payment_id" value="test_payment">
                                <p><small>Razorpay keys are not configured (RAZORPAY_KEY). Test mode is enabled, so you can complete a simulated payment.</small></p>
                                <input type="submit" class="btn" value="Complete test payment (INR {{course.price_inr_fmt}})">
                                {{/paymentTestMode}}
                                {{^paymentTestMode}}
                                <p><small>Online card/UPI payments are not configured yet (set RAZORPAY_KEY and RAZORPAY_SECRET).</small></p>
                                {{/paymentTestMode}}
                                {{/razorpayKey}}
                            </form>
                        </div>
                        <div class="paymentoption">
                            <div class="panel panel-default" style="margin-top: 60px;">

                                {{#flash.success}}
                                    <div class="custom-alerts alert alert-success fade in">
                                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"></button>
                                        {{flash.success}}
                                    </div>
                                    
                                {{/flash.success}}
            
                                {{#flash.error}}
                                    <div class="custom-alerts alert alert-danger fade in">
                                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true"></button>
                                        {{flash.error}}
                                    </div>
                                    
                                {{/flash.error}}
                                <div class="panel-heading"><b>Paywith Paypal</b></div>
                                <div class="panel-body">
                                    <form class="form-horizontal" method="POST" id="payment-form" role="form" action="/paypal">
                                        <input type="hidden" name="_token" value="{{csrf}}">
                                        <input type="hidden" name="order_id" value="{{order.id}}">
                                        
            
                                        <div class="form-group">
                                            <div class="col-md-6 col-md-offset-4">
                                                <button type="submit" class="btn btn-primary">
                                                    Pay USD {{course.price_usd}} via Paypal
                                                </button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>

                            
                        </div>
                    </div>
                </div>
            </div>

            <div class="checkoutsidebar">
                <div class="widget">
                    <h3>You are Purchasing</h3>
                    <div class="pd30">
                        <img src="{{course.photo_url}}">
                        <h4>{{course.title}}</h4>
                        <p>{{course.duration}} / {{course.time_required}}</p>
                        <strong class="price">₹{{course.price_inr_fmt}} </strong>
                        <h6>(Including all taxes)</h6>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section class="section newsLtr" style="background-image:url(/assets/images/newsletter-Bg.jpg);">
    <div class="container">
        <h2>Sign Up Our Newsletter</h2>
        <p>Subscribe our newsletter to receive the latest news and exclusive offers every week.</p>
        <div class="sgForm">
            <form>
                <input type="email"  placeholder="Email Address">
                <input type="submit" class="btn" value="Subscribe" name="submit">
            </form>
        </div>
    </div>
</section>




        <!-- Footer Section Start -->
<footer class="footer">
    <div class="ftrSctn">
        <div class="container">
            <div class="fttTop">
                <div class="ftrlogo"><a href="/"><img src="/assets/images/footerlogo.png" alt="" /></a></div>
                <div class="ftrRit">
                    <div class="soclIcn">
                        <a href="https://www.facebook.com/StudioVaishaliArts/" target="_blank"><img src="/assets/images/facebook.png" alt="" /></a>
                        <a href="https://in.linkedin.com/in/vaishali-jetly-goswami-4b5874233" target="_blank"><img src="/assets/images/linkedin.png" alt="" /></a>
                        <a href="https://www.youtube.com/@artistikcityYT" target="_blank"><img src="/assets/images/youtube.png" alt="" /></a>
                        <a href="https://www.instagram.com/artistikcity/" target="_blank"><img src="/assets/images/instagram.png" alt="" /></a>
                    </div>
                </div>
            </div>
            <div class="fttBtm">
                <div class="fcol">
                    <h6>Latest Courses</h6>
                    <ul id="latestCourses">
                        <li></li>
                    </ul>
                </div>
                <div class="fcol">
                    <h6>Latest Workshop</h6>
                    <ul id="latestWorkshop">
                        <li></li>
                    </ul>
                </div>
                <div class="fcol">
                    <h6>Courses By Age</h6>
                    <ul>
                        <li><a href='#'>Sub-junior - 8 to 12 yrs</a></li>
                        <li><a href='#'>Junior - 12 to 15 yrs</a></li>
                        <li><a href='#'>Adult - 16 yrs and above</a></li>
                    </ul>
                </div>
                <div class="fcol">
                    <h6>Navigation</h6>
                    <ul>
                        <li><a href="/">Home</a></li>
                        <li><a href=/artistikcity-vision>Artistikcity Vision</a></li>
                        <li><a href=/instructor>The Instructor Profile</a></li>
                        <li><a href=/student-feedback>Student Work & Feedback</a></li>
                        <li><a href=/faq>Frequently Asked Questions</a></li>
                        <li><a href=/customer-support>Customer Support</a></li>
                        <li><a href=/contact>Contact</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyRight">
                <p>&copy; Copyright {{year}} Artistick City. All rigthts reserved.</p>
                <p>
                    <a href="/privacy-policy">Privacy Policy</a>
                    <a href="/terms-conditions">Terms & Conditions</a>
                </p>
            </div>
        </div>
    </div>
</footer>
<!-- Footer Section End -->


        <script src="/js/jquery.min.js" type="text/javascript"></script>
        <script src="/js/owl.carousel.js" type="text/javascript"></script>
        <script src="/js/custom.js" type="text/javascript"></script>

        
   <script>
       $('#editBillingInfo').click(function(){
           $('.stepcompleted').show();
       });
   </script> 

<script>
$(document).ready(function() { 
    $.ajax({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        },
        url : "/api/get_footer_data",
        type : 'GET',
        dataType : 'json',
        success : function(result){
            let latestCourses = result.latestCourses;
            let latestWorkshop = result.latestWorkshop;
            var latestCoursesHtml = '';
            var latestWorkshopHtml = '';
            $.each( latestCourses, function( i, val ) {
                latestCoursesHtml += '<li><a href="/course/'+val.slug+'">'+val.title+'</a></li>';
            });
            $.each( latestWorkshop, function( i, value ) {
                latestWorkshopHtml += '<li><a href="/course/'+value.slug+'">'+value.title+'</a></li>';
            });
            // console.log(latestCoursesHtml);
            $('#latestCourses').html(latestCoursesHtml);
            $('#latestWorkshop').html(latestWorkshopHtml);
            // console.log("===== " + result + " =====");

        }
    });
});
</script>

    </body>
</html>
