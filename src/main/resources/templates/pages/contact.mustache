<script>
$(document).ready(function() { 
    $.ajax({
        headers: {
            'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
        },
        url : "/api/get_footer_data",
        type : 'GET',
        dataType : 'json',
        success : function(result){
            let latestCourses = result.latestCourses;
            let latestWorkshop = result.latestWorkshop;
            var latestCoursesHtml = '';
            var latestWorkshopHtml = '';
            $.each( latestCourses, function( i, val ) {
                latestCoursesHtml += '<li><a href="/course/'+val.slug+'">'+val.title+'</a></li>';
            });
            $.each( latestWorkshop, function( i, value ) {
                latestWorkshopHtml += '<li><a href="/course/'+value.slug+'">'+value.title+'</a></li>';
            });
            // console.log(latestCoursesHtml);
            $('#latestCourses').html(latestCoursesHtml);
            $('#latestWorkshop').html(latestWorkshopHtml);
            // console.log("===== " + result + " =====");

        }
    });
});
</script>

